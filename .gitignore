# ─── FreeCAD ────────────────────────────────────────────────────────────
# The .FCStd files are the sources of every printed part, so they are
# tracked. Their backups and crash-recovery copies are not.
*.FCBak
*.FCStd.*

# ─── KiCad: generated files and per-user state ──────────────────────────
*.kicad_prl
fp-info-cache
*-backups/
# auto-backups: the suffix is -bak with a hyphen, not a .bak extension
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
_autosave-*
*.lck
~*.lck
# JLCPCB plugin cache
jlcpcb/

# ─── Fabrication output: regenerated by the Fabrication Toolkit ─────────
production/
*.gbr
*.gbrjob
*.drl
*.zip
*.net

# ─── 3D exports of the boards: regenerated from KiCad ───────────────────
# Part models in Libraries/ are sources and stay tracked.
*.step
*.wrl
!Libraries/**/*.step
!Libraries/**/*.wrl

# ─── Editors and OS ─────────────────────────────────────────────────────
.history/
__pycache__/
.DS_Store
*.tmp
*.swp
*.log
